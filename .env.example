# Copy to .env (gitignored) and replace every value marked CHANGE-ME.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENV=development
LOG_LEVEL=INFO

# ---- PostgreSQL (docker compose) ----
POSTGRES_DB=rideros
POSTGRES_USER=rideros
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000

# ---- Backend ----
# At least 32 characters. Production refuses values that look like placeholders.
JWT_SECRET=CHANGE-ME-to-a-random-string-of-at-least-32-chars
# Used when running the backend or tests on the host (outside docker):
DATABASE_URL=postgresql+asyncpg://rideros:CHANGE-ME@127.0.0.1:5432/rideros
# Tests create and drop this database on the same server:
TEST_DATABASE_URL=postgresql+asyncpg://rideros:CHANGE-ME@127.0.0.1:5432/rideros_test
# ---- ML (docker compose mounts ./ml/artifacts at /artifacts, read-only) ----
# Leave unset to use /artifacts. Set to empty (MODEL_DIR=) to start without the pickup model.
# On the host, point MODEL_DIR at ml/artifacts, e.g. MODEL_DIR=../ml/artifacts (relative to backend/).
# MODEL_DIR=
# RESTAURANT_STATS_DIR=
# ---- RoadContext ----
# docker compose stores report photos in the road-images volume (/data/road_images). On the host,
# point ROAD_IMAGE_DIR at a local folder; empty = photo uploads answer 503.
# ROAD_IMAGE_DIR=
# Per-category duplicate radius / window / TTL (minutes); only the named categories change:
# ROAD_RULES={"flooding": {"radius_m": 300, "window_minutes": 360, "ttl_minutes": 720}}
# ---- Photo classifier (cv_service, Phase 5) ----
# docker compose: the backend calls http://cv:8100 and cv loads cv_service/artifacts/road_cv/1.0.0.
# Set CV_SERVICE_URL= to switch classification off (photos then keep ai_status "none").
# CV_SERVICE_URL=
# CV_MODEL_DIR=
