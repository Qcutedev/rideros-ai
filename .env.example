# Copy to .env (gitignored) and replace every value marked CHANGE-ME.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

ENV=development
LOG_LEVEL=INFO

# ---- PostgreSQL (docker compose) ----
POSTGRES_DB=rideros
POSTGRES_USER=rideros
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000

# ---- Backend ----
# At least 32 characters. Production refuses values that look like placeholders.
JWT_SECRET=CHANGE-ME-to-a-random-string-of-at-least-32-chars
# Used when running the backend or tests on the host (outside docker):
DATABASE_URL=postgresql+asyncpg://rideros:CHANGE-ME@127.0.0.1:5432/rideros
# Tests create and drop this database on the same server:
TEST_DATABASE_URL=postgresql+asyncpg://rideros:CHANGE-ME@127.0.0.1:5432/rideros_test
