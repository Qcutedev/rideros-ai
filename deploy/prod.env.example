# Copy to deploy/.env on the server (gitignored) and replace every CHANGE-ME.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Public host name of the API. With no domain of your own, sslip.io maps the server IP:
# 203.0.113.7 -> api.203-0-113-7.sslip.io (Caddy gets the Let's Encrypt certificate itself).
API_DOMAIN=api.CHANGE-ME.sslip.io

POSTGRES_DB=rideros
POSTGRES_USER=rideros
POSTGRES_PASSWORD=CHANGE-ME
# At least 32 characters; production refuses values that look like placeholders.
JWT_SECRET=CHANGE-ME

# Optional
# LOG_LEVEL=INFO
# WEB_CONCURRENCY=2
# Backups (deploy/backup.sh): where dumps go and how many of each kind are kept.
# BACKUP_DIR=/opt/rideros/backups
# BACKUP_KEEP=7
